<Window x:Class="A_P_SmartHub.Graphics.MainGrap.Registration.WelcomeWidow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_P_SmartHub.Graphics.MainGrap.Registration"
        mc:Ignorable="d"
        Title="WelcomeWidow" Height="450" Width="800">
    <Grid Background="#101725">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Background="#10141D" Grid.ColumnSpan="2">

            <Border Background="#1C2331" CornerRadius="20" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,50,40,40">

                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>

                    <Grid Width="90" Height="90" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <Ellipse Fill="#00D06C" Opacity="0.15"/>
                        <Ellipse Width="60" Height="60" Fill="#00D06C">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00D06C" BlurRadius="20" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#10141D" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>

                    <TextBlock x:Name="WelcomeText" Text="Welcome, User" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                    <TextBlock Text="Thank you for using A&amp;P SmartHub." Foreground="#00D06C" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Text="Your secure and peaceful environment is now ready to be configured." 
                       Foreground="#8B95A5" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"/>

                </StackPanel>
            </Border>
        </Grid>


    </Grid>
</Window>
