<UserControl x:Class="A_P_SmartHub.Graphics.Additional.NoWifiScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:A_P_SmartHub.Graphics.Additional"
             mc:Ignorable="d" 
             Visibility="Visible"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="OfflineOverlay" 
      Visibility="Hidden" 
      Background="#F210141D" 
      Panel.ZIndex="99">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            
               

            <TextBlock Text="No Wi-Fi Connection" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="White" 
                   HorizontalAlignment="Center" />
            <TextBlock Text="Please check your Wi-Fi settings and try again." Foreground="White" Margin="10"/>
            <Button Content="Retry" Width="100" Margin="10" Click="Button_Click" />
        </StackPanel>
    </Grid>
</UserControl>
