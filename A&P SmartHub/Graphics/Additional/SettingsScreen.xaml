<UserControl x:Class="A_P_SmartHub.Graphics.Additional.SettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:A_P_SmartHub.Graphics.Additional"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             RenderOptions.BitmapScalingMode="LowQuality"
             d:DesignHeight="900" d:DesignWidth="1500">
    <Grid Background="#10141D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="17*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="17*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Grid.Row="1" Background="Transparent" Margin="10" CornerRadius="30">
            <Border.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
            </Border.CacheMode>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    
                    <RowDefinition Height="95" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    
                    <TextBlock Margin="10" FontFamily="Bahnschrift" Grid.Column="0" Grid.Row="0" Text="Settings" FontSize="66" FontWeight="Bold" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" />
                
                <Grid Margin="0,-10" Grid.Row="1" VerticalAlignment="Stretch">
                    
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>



                    <Border Grid.Column="1" Margin="10" CornerRadius="30" Background="#1C2331" >
                        <Border.CacheMode>
                            <BitmapCache EnableClearType="False" RenderAtScale="1"/>
                        </Border.CacheMode>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="10" FontFamily="Bahnschrift" Grid.Column="0" Grid.Row="0" Text="Maintenance:" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <ItemsControl x:Name="MaintenanceList" Grid.Row="1">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Background="#151A22" 
                            CornerRadius="8" 
                            Margin="0,0,0,10" 
                            Padding="12">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Icon}" 
                                       Foreground="{Binding IconColor}" 
                                       FontSize="18" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,12,0"/>

                                                <TextBlock Grid.Column="1" 
                                       Text="{Binding Message}" 
                                       Foreground="#D1D5DB" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       TextWrapping="Wrap"/>

                                                <TextBlock Grid.Column="2" 
                                       Text="{Binding Time}" 
                                       Foreground="#64748B" 
                                       FontSize="11" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="1" Margin="10" CornerRadius="30" Background="#1C2331" >
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
                            </Border.CacheMode>
                            <Grid Margin="10">
                                <TextBlock Text="Manage Your Home" FontSize="36" Foreground="White" TextWrapping="Wrap" Margin="0,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Bahnschrift" FontWeight="Bold" />

                                <TextBlock Text="Here you can change you can change your home name" FontSize="15" Foreground="White" TextWrapping="Wrap" Margin="0,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Bahnschrift" />
                                <Border Width="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,100,0,0" Height="40" Background="Transparent" BorderBrush="White" BorderThickness="1" CornerRadius="20" >
                                    <TextBox x:Name="HomeName"  FontSize="18" Foreground="White" TextWrapping="Wrap"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="Bahnschrift" Width="380"   />
                                </Border>

                                <TextBlock Text="Here you can change your City" FontSize="18" Foreground="White" TextWrapping="Wrap" Margin="0,160,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Bahnschrift" />
                                <Border Width="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,200,0,0" Height="40" Background="Transparent" BorderBrush="White" BorderThickness="1" CornerRadius="20" >
                                    <TextBox x:Name="CityName"  FontSize="18" Foreground="White" TextWrapping="Wrap"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="Bahnschrift" Width="380"  />
                                </Border>

                                <TextBlock Text="Here you can change your UserName" FontSize="18" Foreground="White" TextWrapping="Wrap" Margin="0,110,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="Bahnschrift" />
                                <Border Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,150,0,0" Height="40" Background="Transparent" BorderBrush="White" BorderThickness="1" CornerRadius="20" >
                                    <TextBox x:Name="UserName"  FontSize="18" Foreground="White" TextWrapping="Wrap"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="Bahnschrift" Width="380"  />
                                </Border>



                            </Grid>
                        </Border>
                    <Border Grid.Row="0" Margin="10" CornerRadius="30" Background="#1C2331" >
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
                            </Border.CacheMode>
                            <Grid Margin="10">
                            
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock TextWrapping="Wrap" LineHeight="16" Margin="10" FontFamily="Bahnschrift" Grid.Column="0" Grid.Row="1" Text="AP SmartHub
                                       
                A centralized management system for modern IoT ecosystems. Built for speed, scalability, and seamless device integration. Focus less on managing tech and more on living your life.
" FontSize="20" FontWeight="Light" Foreground="White" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                            <TextBlock Margin="10" FontFamily="Bahnschrift" Grid.Column="0" Grid.Row="0" Text="About" FontSize="36" FontWeight="Bold" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <TextBlock Margin="10" FontFamily="Bahnschrift" Grid.Column="0" Grid.Row="1" Text="Version 1.0.0" FontSize="20" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Left"  />


                        </Grid>
                    </Border>
                </Grid>
            </Grid>
                    </Grid>
        </Border>
    </Grid>
</UserControl>
