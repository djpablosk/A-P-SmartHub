<Window x:Class="A_P_SmartHub.Type_devices_with_graphics.RGB_SelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_P_SmartHub.Type_devices_with_graphics"
        mc:Ignorable="d"
        Title="RGB_SelectorWindow" Height="450" Width="800">
    <Grid Background="#10141D">
        <Border Margin="20" CornerRadius="30" Background="#1C2331">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">

                    <Border x:Name="ColorPreview" Height="80" CornerRadius="12" Background="Black" Margin="0,0,0,20"/>

                    <TextBlock Text="Red" Foreground="#FF4D4D" FontWeight="Bold"/>
                    <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Value="0" ValueChanged="Slider_ValueChanged" Margin="0,0,0,10"/>

                    <TextBlock Text="Green" Foreground="#00A870" FontWeight="Bold"/>
                    <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Value="0" ValueChanged="Slider_ValueChanged" Margin="0,0,0,10"/>

                    <TextBlock Text="Blue" Foreground="#4DA6FF" FontWeight="Bold"/>
                    <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Value="0" ValueChanged="Slider_ValueChanged" Margin="0,0,0,20"/>

                    <Button Content="NASTAVIŤ NAMIEŠANÚ FARBU" Click="ApplyColor_Click" Height="40" Background="#333842" Foreground="White" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="RED" Click="BtnQuickRed_Click" Width="80" Height="35" Background="Red" Foreground="White" FontWeight="Bold" Margin="5,0"/>
                        <Button Content="GREEN" Click="BtnQuickGreen_Click" Width="80" Height="35" Background="Green" Foreground="White" FontWeight="Bold" Margin="5,0"/>
                        <Button Content="BLUE" Click="BtnQuickBlue_Click" Width="80" Height="35" Background="Blue" Foreground="White" FontWeight="Bold" Margin="5,0"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
