<UserControl x:Class="A_P_SmartHub.Type_devices_with_graphics.graphicsForDevicesType.MediaTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:A_P_SmartHub.Type_devices_with_graphics.graphicsForDevicesType"
             mc:Ignorable="d" 
             RenderOptions.EdgeMode="Aliased"
             d:DesignHeight="900" d:DesignWidth="1000">
    <Grid>

        <Border Height="500"  Width="700" Background="#1A2235" CornerRadius="30" BorderThickness="1" BorderBrush="#2A3342" Margin="15">
            <Border.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
            </Border.CacheMode>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.4" Color="Black"/>
            </Border.Effect>

            <Border CornerRadius="30"  HorizontalAlignment="Stretch" Background="#1C2331">
                <Border.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1"/>
                </Border.CacheMode>
                <Grid Margin="10" >
                    <TextBlock Text="Media" FontSize="40" FontWeight="Bold" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontFamily="Bahnschrift" Margin="0,10,10,0"/>
                    <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,10,0" Background="Transparent" Content="X" Click="CloseButton_Click" Foreground="White" FontSize="30" BorderThickness="0" Height="50" />


                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="450">

                        <Border Width="90" Height="90">
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
                            </Border.CacheMode>
                            <Viewbox>

                                <Path  Data="{StaticResource IconMedia}" Fill="White"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                            </Viewbox>
                        </Border>

                        <Grid Height="90" VerticalAlignment="Center" Margin="0,50,0,0" >
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Margin="10" BorderThickness="0" Background="#4B5563" FontSize="20" HorizontalAlignment="Stretch" >
                                    <Path Data="M6,6H8V18H6V6M9.5,12L18,18V6L9.5,12Z" 
                          Fill="White" 
                          Width="24" Height="24" 
                          Stretch="Uniform" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>
                                </Button>
                                <Button Margin="10"    Background="#4B5563" Foreground="White" BorderThickness="0" FontSize="20" HorizontalAlignment="Stretch" >
                                    <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" 
                                         Fill="White" 
                                         Width="24" 
                                         Height="24" 
                                         Stretch="Uniform"/>
                                </Button>

                                <Button Margin="10" BorderThickness="0" Background="#4B5563" FontSize="20" HorizontalAlignment="Stretch" >
                                    <Path Data="M6,18L14.5,12L6,6V18M16,6V18H18V6H16Z" 
                                          Fill="White" 
                                          Width="18" Height="18" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Button>


                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                                <TextBlock Text="Volume" FontSize="25" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                                <Slider x:Name="VolumeSlider" Width="200" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#F59E0B"/>
                                <TextBlock x:Name="VolumeText" Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="30" Foreground="White" Margin="0,0,0,0"/>
                          
                        </Grid>

                    </StackPanel>
                </Grid>
            </Border>



        </Border>
            
    </Grid>
</UserControl>
